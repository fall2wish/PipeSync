{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipeSyncManifestSchema",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "minAppVersion",
    "author",
    "entrypoints",
    "integrity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "description": {
      "type": "string",
      "maxLength": 256
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["READ_METADATA", "TRANSFORM_PATH", "INVOKE_WASM", "TRIGGER_WEBHOOK"]
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["hookScript"],
      "properties": {
        "hookScript": { "type": "string" },
        "wasmModule": { "type": "string" }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["hookScriptSha256"],
      "properties": {
        "hookScriptSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "wasmModuleSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
