{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaCleanerConfig",
  "type": "object",
  "properties": {
    "ignoreExtensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        ".tmp",
        ".crdownload"
      ]
    },
    "dateFormat": {
      "type": "string",
      "default": "yyyy-MM-dd"
    }
  }
}